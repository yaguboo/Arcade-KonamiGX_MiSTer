# SEED.  2026-10-08, same netlist seed 12: -0.697 objram_addr_d -> TG68K rot_cnt (known band, untouched).  Seed 9.
# SEED.  2026-10-08, same netlist seed 9: slack -0.068  -0.068 gx_main:u_main|cpu_a32[9]  -> gx_xprot:u_xprot|bus_din[1] .  Seed 8.
# SEED.  2026-10-08, same netlist seed 8: slack -0.130  -0.130 objram_addr_d[3]  -> gx_main:u_main|TG68KdotC_Kernel:u_cpu|TG68K_ALU:ALU|result_di.  Seed 1.
# SEED.  2026-10-08, same netlist seed 1: -0.207 tilemap vram_l -> rom1_addr (band, untouched).  Seed 3.
# SEED.  2026-10-08, same netlist seed 3: slack -0.211  -0.313 gx_esc056:g_esc056.u_esc|esc_cpu:u_cpu|x_key[5]  -> gx_esc056:g_esc056.u_esc|esc_c.  Seed 5.
# SEED.  2026-10-08, 94727eaf netlist: seeds 4 10 12 9 8 1 3 all missed (-0.058 .. -0.697,
# a different untouched path each time).  Seed 5 MET: worst core path +0.092 (tilemap
# vram_h -> rom1_addr), rbf a67648c7.
set_global_assignment -name SEED 5

# No MISTER_FB here.  Gokujou Parodius is horizontal (MAME rotate=0), so
# nothing rotates, so there is no DDR framebuffer and the FB_* ports are tied
# off in KonamiGX.sv.  NA-1/NA-2 needs it for its two vertical games; copying
# that line over would cost resources for a path this core never takes.

#enable it only if 8bit indexed mode is used in core
#set_global_assignment -name VERILOG_MACRO "MISTER_FB_PALETTE=1"

#do not enable DEBUG_NOHDMI in release!
#set_global_assignment -name VERILOG_MACRO "MISTER_DEBUG_NOHDMI=1"

# disable bilinear filtering when downscaling
#set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"

# disable adaptive scanline filtering
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"

#use only 1MB per frame for scaler to free ~21MB DDR3 RAM
#set_global_assignment -name VERILOG_MACRO "MISTER_SMALL_VBUF=1"

# Disable YC / Composite output to save some resources
# Neither is used by this core, and leaving them out makes the build faster and
# the fit easier.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"

# Disable ALSA audio output to save some resources
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

source ../../../../../platforms/mister/sys/sys.tcl
source ../../../../../platforms/mister/sys/sys_analog.tcl
source files.qip
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top

# Framework shift taps as registers, not M10K (2026-10-02, docs/BRAM_AUDIT.md 3):
# shadowmask 4x81 (3 blocks), ascal o_vpix_inner 4x24 (1), vga_out 3x31 (1).
# Tiny delay lines a whole block each; flip-flops cost ~500.  The sys/ files
# are shared by other lanes, so this is an assignment here, not an edit there.
set_instance_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF -to "shadowmask:HDMI_shadowmask"
set_instance_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF -to "ascal:ascal"
set_instance_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF -to "vga_out:vga_scaler_out"
